{
  // =========================================================================
  // Theme & Appearance
  // =========================================================================
  "workbench.colorTheme": "Tokyo Night",
  "workbench.preferredDarkColorTheme": "Tokyo Night",
  "workbench.iconTheme": "material-icon-theme",
  "window.autoDetectColorScheme": false,
  "window.nativeTabs": true,
  "window.restoreFullscreen": true,
  "window.titleBarStyle": "native",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.labelFormat": "short",
  "workbench.editor.useModal": "some",

  // =========================================================================
  // Editor & Typography
  // =========================================================================
  "editor.fontFamily": "\"JetBrains Mono\"",
  "editor.fontSize": 16,
  "editor.fontLigatures": true,
  "editor.wordWrap": "on",
  "editor.mouseWheelZoom": true,
  "editor.parameterHints.cycle": true,
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": true,
  "editor.tabCompletion": "on",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.columnSelection": false,
  "editor.minimap.showSlider": "always",
  "editor.matchBrackets": "never",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.suggestSelection": "first",
  "editor.formatOnType": true,
  "editor.formatOnPaste": true,
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on",
    "other": "on"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.codeLens": true,

  // =========================================================================
  // Files, Search & Local History
  // =========================================================================
  "files.autoSave": "afterDelay",
  "files.autoGuessEncoding": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": false,
  "files.exclude": {
    "**/.history": true,
    "**/.idea": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  },
  "search.seedOnFocus": true,
  "timeline.pageSize": null,
  "workbench.localHistory.enabled": true,

  // =========================================================================
  // Terminal & Debug
  // =========================================================================
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.external.osxExec": "iTerm.app",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "debug.console.fontFamily": "JetBrains Mono",
  "debug.console.fontSize": 16,
  "debug.inlineValues": true,

  // =========================================================================
  // Native Git, Inline Blame & Commit Graph (Replaces GitLens & Git Graph)
  // =========================================================================
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": true,
  "scm.showHistoryGraph": true,

  // =========================================================================
  // Languages: Python (Pylance + Ruff), Jupyter, Flutter/Dart
  // =========================================================================
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "standard",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "workbench.editorAssociations": [
    {
      "viewType": "jupyter-notebook",
      "filenamePattern": "*.ipynb"
    }
  ],
  "dart.flutterSdkPath": "/Users/darshanas/flutter",
  "[dart]": {
    "editor.formatOnSave": true
  },

  // =========================================================================
  // Spell Checker
  // =========================================================================
  "cSpell.userWords": [
    "CREDAPIs",
    "IPAD",
    "MACOS",
    "anyclass",
    "foldl"
  ],

  // =========================================================================
  // AI / Copilot Chat
  // =========================================================================
  "github.copilot.chat.cli.remote.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://api.github.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://raw.githubusercontent.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://firebase.google.com": true,
    "https://firebase.blog": true,
    "https://pub.dev": true
  },
  "chat.tools.terminal.autoApprove": {
    "dart": true,
    "flutter": true,
    "mv": true
  },

  // =========================================================================
  // Settings Sync Protection (Prevent remote/corp machines from wiping local config)
  // =========================================================================
  "settingsSync.ignoredSettings": [
    "http.systemCertificates",
    "yaml.disableSchemaDetection",
    "git.autofetch",
    "dart.flutterSdkPath"
  ]
}
