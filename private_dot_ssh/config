Include /Users/darshanas/.colima/ssh_config

# Ensure corporate Google hosts ONLY use macOS system SSH agent (gcert) and glinux key
Host *.google.com *.googlers.com *.goog *.corp
    IdentityAgent SSH_AUTH_SOCK
    IdentityFile ~/.ssh/id_rsa_glinux

# Personal Git hosts via Bitwarden SSH Agent
Host github.com gitlab.com
    IdentityAgent ~/.bitwarden-ssh-agent.sock
    IdentityFile ~/.ssh/id_ed25519_personal.pub
    IdentitiesOnly yes

# Home Assistant OS SSH config
Host homeassistant
    HostName home-ssh.darshanas.dev
    User root
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
    IdentityAgent ~/.bitwarden-ssh-agent.sock
    IdentityFile ~/.ssh/id_ed25519_personal.pub
    IdentitiesOnly yes

Host homeassistant-remote
    HostName home-ssh.darshanas.dev
    User root
    ProxyCommand cloudflared access ssh --hostname %h
    IdentityAgent ~/.bitwarden-ssh-agent.sock
    IdentityFile ~/.ssh/id_ed25519_personal.pub
    IdentitiesOnly yes

Host homeassistant-local
    HostName homeassistant.local
    User root
    Port 22
    IdentityAgent ~/.bitwarden-ssh-agent.sock
    IdentityFile ~/.ssh/id_ed25519_personal.pub
    IdentitiesOnly yes

Host penguin-ssh.darshanas.dev
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
    IdentityAgent ~/.bitwarden-ssh-agent.sock
    IdentityFile ~/.ssh/id_ed25519_personal.pub
    IdentitiesOnly yes
    ForwardAgent yes

# Generated by Jetski
Host darshanas-glinux.c.googlers.com
	HostName darshanas-glinux.c.googlers.com
